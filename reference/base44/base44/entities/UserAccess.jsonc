{
  "name": "UserAccess",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "role": {
      "type": "string",
      "enum": [
        "Membro da dire\u00e7\u00e3o da campanha",
        "Membro da supervis\u00e3o das campanhas"
      ],
      "description": "Cargo do usu\u00e1rio"
    },
    "congregation_id": {
      "type": "string",
      "description": "ID da congrega\u00e7\u00e3o (null para supervis\u00e3o)"
    }
  },
  "required": [
