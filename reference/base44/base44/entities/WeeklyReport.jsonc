{
  "name": "WeeklyReport",
  "type": "object",
  "properties": {
    "congregation_id": {
      "type": "string",
      "description": "ID da congrega\u00e7\u00e3o"
    },
    "week_start": {
      "type": "string",
      "description": "Data de in\u00edcio da semana reportada (segunda-feira, YYYY-MM-DD)"
    },
    "confirmed_by_email": {
      "type": "string",
      "description": "Email de quem confirmou"
    },
    "confirmed_by_name": {
      "type": "string",
      "description": "Nome de quem confirmou"
    }
  },
  "required": [
    "congregation_id",
    "week_start",
    "confirmed_by_email"
  ]
}