{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "user_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "message": {
      "type": "string",
      "description": "Mensagem de feedback"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "read",
        "resolved"
      ],
      "description": "Status do feedback"
    }
  },
  "required": [
    "message"
  ]
}