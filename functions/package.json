{
  "name": "discipulado-ieadpe-functions",
  "private": true,
  "version": "0.1.0",
  "description": "Trusted backend foundation for the Discipulado IEADPE Firebase project.",
  "main": "lib/src/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
