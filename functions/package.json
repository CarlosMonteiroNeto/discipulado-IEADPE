    "test:emulator": "vitest run test/security",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.1",
    "firebase": "^12.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
