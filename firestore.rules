rules_version = '2';

// Internal-mode authorization matrix for the Discipulado IEADPE app.
//
// The app runs on the Firebase Spark plan without Cloud Functions: every
// mutation is a role-scoped client write performed by the handlers of the
// direct Firestore transport, so this ruleset grants writes to the role that
// owns them instead of denying every client write. Reads keep the scoped
// projections of S04. The nested matches below are explicit on purpose: a
// recursive wildcard would also match the parent congregation document and
// every internal subcollection.
//
// Bootstrap (internal-mode trust model): a signed-in user may self-create and
// self-update their OWN users profile. `accessRole == 'supervisor'` on such a
// write is granted only when the authenticated token email equals the single
// allowlist credential below — the owner account email created in the Firebase
// console during delivery. Replace it with the real address before deploying.
service cloud.firestore {
  match /databases/{database}/documents {

    // The internal bootstrap credential: the owner account email. Only this
    // address may self-provision a 'supervisor' profile (see README
    // "Internal mode (no billing)").
    function allowlistedOwner() {
      return 'ccm.neto@gmail.com';
    }

    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(currentUid()));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(currentUid())).data;
    }

    function activeProfile() {
      return hasProfile() && profile().active == true;
    }

    function isSupervisor() {
      return activeProfile() && profile().accessRole == 'supervisor';
    }

    function isStaffOf(congregationId) {
      return activeProfile()
        && profile().accessRole == 'congregationStaff'
        && profile().congregationId == congregationId;
    }

    // Reads: supervisors anywhere, staff only their assigned congregation.
    // The path already carries the congregation id, so no duplicated field
    // check is required.
    function mayReadCongregation(congregationId) {
      return isSupervisor() || isStaffOf(congregationId);
    }

    // Writes mirror the read scoping in internal mode: supervisors anywhere,
    // staff within their own congregation.
    function mayWriteCongregation(congregationId) {
      return isSupervisor() || isStaffOf(congregationId);
    }

    // The directory projection is maintained by the client one entry at a
    // time; each entry carries the congregation it belongs to, so staff writes
    // are scoped by that field and supervisors may write anywhere.
    function mayWriteDirectory() {
      return isSupervisor()
          || (activeProfile()
              && profile().accessRole == 'congregationStaff'
              && (resource == null ? request.resource.data.congregationId
                  : resource.data.congregationId) == profile().congregationId);
    }

    // Self-owned access profile. Self create/update is the internal-mode
    // bootstrap; supervisor self-claim is gated by the allowlist email.
    match /users/{userId} {
      allow read: if signedIn() && userId == currentUid();
      allow create: if signedIn()
          && userId == currentUid()
          && request.resource.data.accessRole in ['congregationStaff', 'supervisor']
          && (request.resource.data.accessRole != 'supervisor'
              || request.auth.token.email == allowlistedOwner());
      allow update: if signedIn()
          && userId == currentUid()
          && request.resource.data.accessRole in ['congregationStaff', 'supervisor']
          && (request.resource.data.accessRole != 'supervisor'
              || request.auth.token.email == allowlistedOwner());
      allow delete: if false;
    }

    // Congregational records (S04 reads + internal-mode writes).
    match /congregations/{congregationId} {
      // Active congregation names are readable by authenticated staff;
      // archived congregations are supervisor-protected.
      allow read: if activeProfile() && (isSupervisor() || resource.data.active == true);
      allow write: if mayWriteCongregation(congregationId);

      match /contacts/{contactId} {
        allow read: if mayReadCongregation(congregationId);
        allow write: if mayWriteCongregation(congregationId);
      }

      match /students/{studentId} {
        allow read: if mayReadCongregation(congregationId);
        allow write: if mayWriteCongregation(congregationId);
      }

      match /classes/{classId} {
        allow read: if mayReadCongregation(congregationId);
        allow write: if mayWriteCongregation(congregationId);

        // The per-class historical roster entry written at enrollment and read
        // to freeze attendance membership; scoped like the class itself.
        match /roster/{rosterId} {
          allow read: if mayReadCongregation(congregationId);
          allow write: if mayWriteCongregation(congregationId);
        }
      }

      match /enrollments/{enrollmentId} {
        allow read: if mayReadCongregation(congregationId);
        allow write: if mayWriteCongregation(congregationId);
      }

      // The internal single-active-enrollment uniqueness records: written at
      // enrollment, deleted at close and read by the student archive guard.
      match /activeEnrollmentRefs/{refId} {
        allow read: if mayReadCongregation(congregationId);
        allow write: if mayWriteCongregation(congregationId);
      }

      match /sessions/{sessionId} {
        allow read: if mayReadCongregation(congregationId);
        allow write: if mayWriteCongregation(congregationId);

        // Attendance is a scoped private record (S04), writable in internal
        // mode by the same role.
        match /attendance/{attendanceId} {
          allow read: if mayReadCongregation(congregationId);
          allow write: if mayWriteCongregation(congregationId);
        }

        // The frozen session roster is maintained by the client on first
        // attendance; staff/supervisors of the congregation may touch it.
        match /roster/{rosterId} {
          allow read: if mayReadCongregation(congregationId);
          allow write: if mayWriteCongregation(congregationId);
        }
      }

      // Internal role-slot records are equally client-owned now, read and
      // written only by the congregation staff/supervisors.
      match /roleSlots/{slotId} {
        allow read: if mayReadCongregation(congregationId);
        allow write: if mayWriteCongregation(congregationId);
      }
    }

    // Minimal authenticated directory projection, maintained by the client.
    match /directory/{contactId} {
      allow read: if activeProfile();
      allow write: if mayWriteDirectory();
    }

    // Supervision records are supervisor-only.
    match /supervisionContacts/{contactId} {
      allow read: if isSupervisor();
      allow write: if isSupervisor();
    }

    match /supervisionRoleSlots/{slotId} {
      allow read: if isSupervisor();
      allow write: if isSupervisor();
    }

    // Collection-group reads serve the supervisor all-scope dashboard and
    // pending-session list (the staff paths stay scoped through the matches
    // above). Only supervisors may run group queries; the wildcard matcher
    // binds nothing, so staff cannot leak other congregations this way.
    match /{path=**}/students/{studentId} {
      allow read: if isSupervisor();
      allow write: if false;
    }

    match /{path=**}/classes/{classId} {
      allow read: if isSupervisor();
      allow write: if false;
    }

    match /{path=**}/sessions/{sessionId} {
      allow read: if isSupervisor();
      allow write: if false;
    }

    // Unspecified paths deny every read and write.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}